# Contacless Order Service - Environment Variables
# Copy this file to .env and fill in your values

# Project
PROJECT_NAME="Contacless Order Service"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contacless_order"

VIETQR_BANK_ID=mbbank         # or vietcombank, techcombank, etc.
VIETQR_ACCOUNT_NO=your phone number
VIETQR_ACCOUNT_NAME= you name
CASSO_API_KEY=your_key
# Security
SECRET_KEY="your-secret-key-change-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudflare Tunnel (optional - for public HTTPS access)
# Get your token from: https://one.dash.cloudflare.com/ -> Networks -> Tunnels
# See docs/cloudflare-tunnel-setup.md for setup instructions
CLOUDFLARE_TUNNEL_TOKEN=
