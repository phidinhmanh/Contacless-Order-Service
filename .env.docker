# ================================================
# Contacless Order Service - Docker Deployment
# ================================================
# INSTRUCTIONS:
# 1. Start ngrok for frontend: ngrok http 3000
# 2. Start ngrok for backend:  ngrok http 8000
# 3. Update FRONTEND_URL and BACKEND_URL below with ngrok URLs
# 4. Run: docker-compose --env-file .env.docker up --build -d
# 5. Regenerate QRs: docker exec contacless-backend python scripts/regenerate_qrs.py
# ================================================

# === PUBLIC URLs (UPDATE WHEN NGROK RESTARTS) ===
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# === CORS Configuration ===
# Allow ngrok wildcard domains for external testing
CORS_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.io,http://localhost:3000

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@db:5432/contacless_order

# === Security ===
SECRET_KEY=docker-dev-secret-key-change-in-production

# === VietQR (Optional) ===
VIETQR_BANK_ID=mbbank
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
